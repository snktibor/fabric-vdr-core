{
  "$schema": "https://github.com/hyperledger-labs/fablo/releases/download/2.6.0/schema.json",
  "global": {
    "fabricVersion": "2.5.15",
    "tls": true,
    "peerDevMode": false,
    "engine": "docker"
  },
  "orgs": [
    {
      "organization": {
        "name": "Orderer",
        "domain": "orderer.example.com",
        "mspName": "OrdererMSP"
      },
      "ca": {
        "prefix": "ca",
        "db": "sqlite"
      },
      "orderers": [
        {
          "groupName": "group1",
          "type": "raft",
          "instances": 3,
          "prefix": "orderer"
        }
      ],
      "tools": {
        "fabloRest": true
      }
    },
    {
      "organization": {
        "name": "Org1",
        "domain": "org1.example.com",
        "mspName": "Org1MSP"
      },
      "ca": {
        "prefix": "ca",
        "db": "sqlite"
      },
      "orderers": [],
      "peer": {
        "instances": 2,
        "db": "LevelDb",
        "prefix": "peer"
      },
      "tools": {
        "fabloRest": true
      }
    },
    {
      "organization": {
        "name": "Org2",
        "domain": "org2.example.com",
        "mspName": "Org2MSP"
      },
      "ca": {
        "prefix": "ca",
        "db": "sqlite"
      },
      "orderers": [],
      "peer": {
        "instances": 2,
        "db": "LevelDb",
        "prefix": "peer"
      },
      "tools": {
        "fabloRest": true
      }
    },
    {
      "organization": {
        "name": "Org3",
        "domain": "org3.example.com",
        "mspName": "Org3MSP"
      },
      "ca": {
        "prefix": "ca",
        "db": "sqlite"
      },
      "orderers": [],
      "peer": {
        "instances": 2,
        "db": "LevelDb",
        "prefix": "peer"
      },
      "tools": {
        "fabloRest": true
      }
    }
  ],
  "channels": [
    {
      "name": "my-channel1",
      "orgs": [
        {
          "name": "Org1",
          "peers": [
            "peer0",
            "peer1"
          ]
        },
        {
          "name": "Org2",
          "peers": [
            "peer0",
            "peer1"
          ]
        },
        {
          "name": "Org3",
          "peers": [
            "peer0",
            "peer1"
          ]
        }
      ]
    }
  ],
  "chaincodes": [
    {
      "name": "vdrchaincode",
      "version": "0.0.7",
      "lang": "ccaas",
      "channel": "my-channel1",
      "directory": "../..",
      "image": "vdr-chaincode:bench",
      "privateData": [],
      "endorsement": "OutOf(2, 'Org1MSP.member', 'Org2MSP.member', 'Org3MSP.member')"
    }
  ]
}
