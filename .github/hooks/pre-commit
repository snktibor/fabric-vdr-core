#!/bin/sh
# Pre-commit hook: format check + unit tests.
#
# This file is a template; git does not run it from .github/. Install it with:
#   cp .github/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# or point git at this directory:
#   git config core.hooksPath .github/hooks
#
# Bypass in a hurry with: git commit --no-verify

set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: mvn spotless:check"
if ! mvn -q spotless:check; then
  echo "pre-commit: formatting errors — run 'mvn spotless:apply' and re-stage." >&2
  exit 1
fi

echo "pre-commit: mvn test"
if ! mvn -q test; then
  echo "pre-commit: unit tests failed." >&2
  exit 1
fi

echo "pre-commit: OK"
